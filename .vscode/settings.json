{
    // "python.envFile": "${workspaceFolder}/.env", // Archivo .env opcional para activar automáticamente el venv al abrir VS Code    
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python", // Usa automáticamente el intérprete del venv
    "python.analysis.autoSearchPaths": true, // Pylance busca automáticamente los paths de librerías del intérprete activo
    "python.analysis.useLibraryCodeForTypes": true, // Usa tipos de librerías externas para autocompletado y verificación
    "python.terminal.activateEnvironment": true, // [OPTIONAL] Activa la terminal apenas se abre el proyecto 
    "mypy-type-checker.ignorePatterns": [
        "**/.venv/**",
        "**/build/**",
        "**/dist/**",
        ".direnv/*",
        "docs/*",
        "*generated/*",
        "*<common-submodule-name>/*",
        "*cache*",
        "dist*"
    ],
    "mypy-type-checker.importStrategy": "fromEnvironment",
    "mypy-type-checker.reportingScope": "workspace",
    "mypy-type-checker.preferDaemon": false,
    "mypy-type-checker.showNotifications": "onError",
    "mypy-type-checker.args": [
        "--config-file=${workspaceFolder}/mypy.ini"
    ],
    "editor.formatOnSave": true,
    "[python]": {
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
        },
        "editor.defaultFormatter": "charliermarsh.ruff"
    },
    "[toml]": {
        "editor.defaultFormatter": "tamasfe.even-better-toml",
        "editor.formatOnSave": true
    },
    "todo-tree.filtering.excludeGlobs": [
        "**/.venv/**",
        "**/build/**",
        "**/dist/**"
    ],
    "todo-tree.general.tags": [
        "TODO",
        "README",
        "FIXME"
    ],
    "todo-tree.highlights.defaultHighlight": {
        "type": "tag",
        "fontWeight": "bold"
    },
    "todo-tree.highlights.customHighlight": {
        "TODO": {
            "icon": "check",
            "foreground": "#ffffff",
            "background": "#2563eb"
        },
        "README": {
            "icon": "book",
            "foreground": "#ffffff",
            "background": "#7c3aed"
        },
        "FIXME": {
            "icon": "flame",
            "foreground": "#ffffff",
            "background": "#dc2626"
        }
    },
    "todo-tree.tree.showCountsInTree": true,
    "todo-tree.tree.showBadges": true
}